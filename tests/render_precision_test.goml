package tests;

use ecosystem::ansi;
use ecosystem::progress;
use std::testing;
use std::num::{ToFloat};

fn bar_snapshot(position: i64, total: i64) -> progress::JobSnapshot {
    progress::JobSnapshot {
        id: 1,
        name: "job",
        message: "",
        position,
        total: Option::Some(total),
        status: progress::Status::Running,
        elapsed_ms: 0,
        per_second: Option::None,
        eta_ms: Option::None,
        frame: 0,
    }
}

#[test]
fn bar_fill_preserves_exact_integer_boundaries() -> () {
    let style = progress::Style { bar_columns: 100, ..progress::Style::defaults() };
    for position in 0..101 {
        let line = testing::expect_ok(
            progress::render_job(
                bar_snapshot(position.to_i64(), 100),
                4096,
                style,
                ansi::Profile::Plain,
            ),
            "render exact percentage",
        );
        testing::assert_eq(
            line,
            "| job [" + "=".repeat(position) + "-".repeat(100 - position) + f"] {position}/100",
        );
    }
}

#[test]
fn bar_fill_at_maximum_position_and_width_stays_bounded() -> () {
    let style = progress::Style { bar_columns: 512, ..progress::Style::defaults() };
    for (position, total, filled) in[
        (0, 0, 512),
        (0, progress::MAX_POSITION, 0),
        (progress::MAX_POSITION - 1, progress::MAX_POSITION, 511),
        (progress::MAX_POSITION, progress::MAX_POSITION, 512),
    ] {
        let line = testing::expect_ok(
            progress::render_job(bar_snapshot(position, total), 4096, style, ansi::Profile::Plain),
            "render maximum bar",
        );
        testing::assert_eq(
            line,
            "| job [" + "=".repeat(filled) + "-".repeat(512 - filled) + f"] {position}/{total}",
        );
    }
}

#[test]
fn rate_rendering_preserves_decimal_tenths() -> () {
    let style = progress::Style { bar_columns: 0, ..progress::Style::defaults() };
    for tenths in 0..101 {
        let snapshot = progress::JobSnapshot {
            per_second: Option::Some(tenths.to_f64() / 10.0),
            ..bar_snapshot(0, 100),
        };
        testing::assert_eq(
            testing::expect_ok(
                progress::render_job(snapshot, 100, style, ansi::Profile::Plain),
                "rate",
            ),
            f"| job 0/100 {tenths / 10}.{tenths % 10}/s",
        );
    }
}

#[test]
fn rate_rendering_rounds_with_carry_and_preserves_large_integer_parts() -> () {
    let style = progress::Style { bar_columns: 0, ..progress::Style::defaults() };
    for (rate, expected) in[
        (0.0, "0.0"),
        (0.125, "0.1"),
        (1.25, "1.3"),
        (1.99, "2.0"),
        (4503599627370495.5, "4503599627370495.5"),
        (9007199254740990.0, "9007199254740990.0"),
        (progress::MAX_POSITION.to_f64(), ">=9007199254740991"),
        (-1.0, "?"),
        (float64_from_bits(0x7ff0000000000000), "?"),
        (float64_from_bits(0x7ff8000000000000), "?"),
    ] {
        let snapshot = progress::JobSnapshot {
            per_second: Option::Some(rate),
            ..bar_snapshot(0, 100),
        };
        testing::assert_eq(
            testing::expect_ok(
                progress::render_job(snapshot, 100, style, ansi::Profile::Plain),
                "rate",
            ),
            "| job 0/100 " + expected + "/s",
        );
    }
}
